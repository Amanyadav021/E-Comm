# ============================================================
# ShopCraft environment configuration (copy to apps/api/.env)
# Never commit real secrets. All values here are placeholders.
# ============================================================

# ---- Runtime ----
NODE_ENV=development
API_PORT=4000
# Comma-separated origins allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- Database (PostgreSQL) ----
# Local:  postgresql://postgres:postgres@localhost:5432/ecommerce_dev?schema=public
# Neon:   postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ecommerce_dev?schema=public

# ---- docker compose only (the db service) ----
POSTGRES_USER=shopcraft
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopcraft

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900          # seconds (15 min)
JWT_REFRESH_TTL=2592000     # seconds (30 days)
COOKIE_SECURE=false         # true in production (HTTPS)

# ---- Google OAuth (customer "Sign in with Google") ----
# Create OAuth Client ID (Web) at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# ---- Phone OTP ----
# dev = OTP logged to API console (and returned in response in dev only)
# msg91 / twilio = real SMS provider
OTP_PROVIDER=dev
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Payments ----
# mock = local dev gateway that exercises the full verify/webhook flow
# razorpay = real gateway
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Secret used by the mock gateway to sign simulated webhooks (dev only)
MOCKPAY_SECRET=dev-mockpay-secret

# ---- File storage ----
# local = apps/api/uploads (DEV ONLY — a container's disk is wiped on redeploy,
#         so product images uploaded in the admin would vanish)
# s3    = any S3-compatible bucket: Supabase Storage, Cloudflare R2, AWS, MinIO
STORAGE_PROVIDER=local

# Supabase Storage: create a PUBLIC bucket, then Dashboard > Storage > S3 Access Keys
#   S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
#   S3_REGION=<your project region, e.g. ap-northeast-2>
#   S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- Email (order notifications) ----
# dev = emails logged to console; smtp = real SMTP server
EMAIL_PROVIDER=dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopCraft <no-reply@example.com>"

# ---- Frontend base URLs (used in emails / redirects) ----
WEB_BASE_URL=http://localhost:3000
ADMIN_BASE_URL=http://localhost:3100
API_PUBLIC_URL=http://localhost:4000
